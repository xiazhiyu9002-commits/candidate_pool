# KeRui Recruit 本地开发环境变量模板。
# 复制为 .env 后填写真实密钥（.env 已被 .gitignore 忽略，不会提交）。
# 运行时也会读取进程环境变量（Tauri 桌面壳层注入）。

# DeepSeek LLM（简历/JD 结构化解析、推荐理由、意图解析）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 硅基流动（Embedding + Reranker）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Tavily（BD 线索网络搜索）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# 邮箱被动入库（可选，不配置则跳过邮箱监听）
IMAP_HOST=
IMAP_ACCOUNT=
IMAP_AUTH_CODE=
IMAP_WHITELIST=boss.com,liepin.com

# 提醒邮件发送（可选，不配置则跳过邮件提醒）
SMTP_HOST=
SMTP_PORT=465
SMTP_ACCOUNT=
SMTP_AUTH_CODE=
SMTP_SSL=true
REMINDER_TO=